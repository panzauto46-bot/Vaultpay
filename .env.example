# ============================================================================
# VaultPay — Environment Configuration (Base Sepolia <-> Reactive Omni)
# ============================================================================

# 1. Deployer Wallet Private Key (Ensure funded with Base Sepolia ETH & lREACT)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# 2. Base Sepolia Testnet (Origin & Destination Chain - 200ms Blocks)
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CALLBACK_PROXY=0xa6eA49Ed671B8a4dfCDd34E36b7a75Ac79B8A5a6

# 3. Reactive Omni / Lasna Testnet (Autonomous Brain - ~1s Blocks)
REACTIVE_OMNI_CHAIN_ID=5318007
REACTIVE_OMNI_RPC_URL=https://lasna-rpc.rnk.dev/
REACTIVE_SYSTEM_CONTRACT=0x0000000000000000000000000000000000fffFfF

# 4. Deployed Contract Addresses (Populated after deployment)
VAULTPAY_CORE_ADDRESS=0x0000000000000000000000000000000000000000
VAULTPAY_REACTIVE_ADDRESS=0x0000000000000000000000000000000000000000

# 5. Next.js Frontend Public Variables
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_REACTIVE_OMNI_RPC=https://lasna-rpc.rnk.dev/
NEXT_PUBLIC_VAULTPAY_CORE_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_VAULTPAY_REACTIVE_ADDRESS=0x0000000000000000000000000000000000000000
